<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/donateLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/app_background_gradient">

    <!-- Screen title -->
    <TextView
        android:id="@+id/tvDonateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_donate"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.02"
        android:paddingTop="56dp"
        android:paddingBottom="20dp"
        android:gravity="center" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section header: Recipient -->
            <TextView
                android:id="@+id/tvHistoryHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_history_of_service"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F2FFFFFF"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <!-- Recipient Card: Hospital -->
            <LinearLayout
                android:id="@+id/cardHospital"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_modern_bg"
                android:layout_marginBottom="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvHospitalName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recipient_hospital"
                    android:textSize="16sp"
                    android:textColor="#222222" />

                <Button
                    android:id="@+id/btnDonateHospital"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/btn_go"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_secondary_gradient"
                    android:stateListAnimator="@null"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />
            </LinearLayout>

            <!-- Recipient Card: Day Care -->
            <LinearLayout
                android:id="@+id/cardDayCare"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_modern_bg"
                android:layout_marginBottom="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvDayCareName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recipient_daycare"
                    android:textSize="16sp"
                    android:textColor="#222222" />

                <Button
                    android:id="@+id/btnDonateDayCare"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/btn_go"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_secondary_gradient"
                    android:stateListAnimator="@null"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />
            </LinearLayout>

            <!-- Recipient Card: Salvation Army -->
            <LinearLayout
                android:id="@+id/cardSalvationArmy"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_modern_bg"
                android:layout_marginBottom="22dp"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvSalvationArmyName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recipient_salvation_army"
                    android:textSize="16sp"
                    android:textColor="#222222" />

                <Button
                    android:id="@+id/btnDonateSalvationArmy"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/btn_go"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_secondary_gradient"
                    android:stateListAnimator="@null"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />
            </LinearLayout>

            <!-- Section: Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_amount"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F2FFFFFF"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <TextView
                    android:id="@+id/chipAmount10"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/amount_10"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/chipAmount20"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/amount_20"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/chipAmount50"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/amount_50"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/chipAmountCustom"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/amount_custom"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />
            </LinearLayout>

            <!-- Section: Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_category"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F2FFFFFF"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <TextView
                    android:id="@+id/chipCatClothes"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/cat_clothes"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/chipCatFood"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/cat_food"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/chipCatToys"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/cat_toys"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/chipCatMoney"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/cat_money"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />
            </LinearLayout>

            <!-- Section: Pickup time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_pickup_time"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F2FFFFFF"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/btnPickupTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/card_modern_bg"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/placeholder_pickup_time"
                android:textColor="#666666"
                android:textSize="14sp"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:drawableTint="@color/purple_primary"
                android:layout_marginBottom="22dp" />

            <!-- Slide to confirm -->
            <TextView
                android:id="@+id/tvSlideLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_slide_to_donate"
                android:textSize="13sp"
                android:textColor="#F2FFFFFF"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:layout_gravity="center" />

            <SeekBar
                android:id="@+id/seekBarDonate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/slider_track_gradient"
                android:thumb="@drawable/slider_thumb"
                android:minHeight="28dp"
                android:maxHeight="28dp"
                android:layout_marginBottom="20dp" />

            <!-- Main Donate Button -->
            <Button
                android:id="@+id/btnDonate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_donate"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_primary_gradient"
                android:stateListAnimator="@null"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav bar -->
    <LinearLayout
        android:id="@+id/bottomNavDonate"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@drawable/nav_bar_translucent_bg">

        <ImageButton
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Settings"
            android:src="@android:drawable/ic_menu_preferences" />

        <ImageButton
            android:id="@+id/navServices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Services Near Me"
            android:src="@android:drawable/ic_menu_mapmode" />

        <ImageButton
            android:id="@+id/navDonate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Donate"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/purple_primary" />

        <ImageButton
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Donation History"
            android:src="@android:drawable/ic_menu_recent_history" />

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Profile"
            android:src="@android:drawable/ic_menu_my_calendar" />
    </LinearLayout>

</LinearLayout>
